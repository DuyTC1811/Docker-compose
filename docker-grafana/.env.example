# Copy thành .env rồi sửa theo dự án:  cp .env.example .env

# Thư mục log của app trên host (ĐƯỜNG DẪN TUYỆT ĐỐI).
# Quy ước: mỗi service ghi log vào một thư mục con trùng spring.application.name
#   /home/duy/logs/fx-disbursement/app.log  -> service_name="fx-disbursement" trong Loki
APP_LOG_DIR=./logs

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS=true

# Phiên bản image: nâng cấp tại đây
GRAFANA_VERSION=12.1.0
MIMIR_VERSION=2.17.0
LOKI_VERSION=3.5.0
TEMPO_VERSION=2.8.1
ALLOY_VERSION=v1.10.0
OBI_VERSION=v0.15.2

DB_URL=jdbc:postgresql://192.168.122.102:5432/postgres
DB_USERNAME=duytc
DB_PASSWORD=anhduy12
