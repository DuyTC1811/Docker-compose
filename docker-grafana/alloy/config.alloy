logging {
  level  = "info"
  format = "logfmt"
}

// ==================== METRICS ====================
// App Spring Boot: gọi qua tên service trong compose network
prometheus.scrape "spring_apps" {
  targets = [
    {"__address__" = "observability:8081", "job" = "spring-boot", "application" = "observability"},
  ]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "15s"
  honor_labels    = true
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

// OBI chạy network host, nên đi qua host-gateway
// (compose của alloy cần: extra_hosts: ["host.docker.internal:host-gateway"])
prometheus.scrape "obi" {
  targets         = [{"__address__" = "host.docker.internal:9400", "job" = "obi"}]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
  external_labels = { env = "dev" }
}

// ==================== TRACES + OTLP METRICS ====================
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.mimir.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}

// OTLP metrics -> Prometheus format -> Mimir (dùng chung remote_write ở trên)
otelcol.exporter.prometheus "mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// ==================== LOGS (stdout container) ====================
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["logging=alloy"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  // service_name = label "app", nếu không có thì fallback sang tên service compose
  rule {
    source_labels = ["__meta_docker_container_label_app", "__meta_docker_container_label_com_docker_compose_service"]
    separator     = ";"
    regex         = "^;?([^;]+);?.*$"
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.ecs.receiver]
}

loki.process "ecs" {
  // Hỗ trợ cả ECS phẳng ("log.level") lẫn ECS lồng ({"log":{"level":...}})
  stage.json {
    expressions = {
      level    = "\"log.level\" || log.level",
      trace_id = "\"trace.id\" || trace.id || traceId || trace_id",
      span_id  = "\"span.id\" || span.id || spanId || span_id",
    }
  }
  stage.labels {
    values = { level = "" }
  }
  // Cần Loki schema v13 + tsdb, allow_structured_metadata = true
  stage.structured_metadata {
    values = { trace_id = "", span_id = "" }
  }
  // Che 8 số giữa của PAN 16 số: 4111111111111111 -> 4111********1111
  stage.replace {
    expression = `\b\d{4}(\d{8})\d{4}\b`
    replace    = "********"
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = { env = "dev" }
}