// ---------- LOGS: stdout của container có label logging=alloy ----------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["logging=alloy"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_label_app"]
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.ecs.receiver]
}

loki.process "ecs" {
  stage.json {
    expressions = {
      level    = "\"log.level\"",
      trace_id = "\"trace.id\" || traceId || trace_id",   // ECS / MDC / OBI
      span_id  = "\"span.id\" || spanId || span_id",
    }
  }
  stage.labels { values = { level = "" } }
  stage.structured_metadata {
    values = { trace_id = "", span_id = "" }
  }
  stage.replace {
    expression = `\b\d{4}(\d{4,11})\d{4}\b`
    replace    = "****"
  }
  forward_to = [loki.write.default.receiver]
}